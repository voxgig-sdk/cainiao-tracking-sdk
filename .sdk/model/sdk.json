                    "json": "{\"operationId\":\"getTrackingDetail\",\"parameters\":[{\"description\":\"Tracking number(s) for the shipment(s). Multiple tracking numbers can be provided separated by commas.\",\"example\":\"ZH363796677HK\",\"in\":\"query\",\"name\":\"mailNos\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Language code for the response (e.g., en-US, zh-CN, fr-FR)\",\"example\":\"en-US\",\"in\":\"query\",\"name\":\"lang\",\"required\":false,\"schema\":{\"default\":\"en-US\",\"type\":\"string\"}},{\"description\":\"Alternative language parameter for response localization\",\"example\":\"en-US\",\"in\":\"query\",\"name\":\"language\",\"required\":false,\"schema\":{\"default\":\"en-US\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"data\":{\"destCountry\":\"US\",\"latestTrackingInfo\":{\"desc\":\"Delivered\",\"location\":\"New York, US\",\"time\":\"2024-01-15T10:30:00Z\"},\"mailNo\":\"ZH363796677HK\",\"originCountry\":\"CN\",\"status\":\"DELIVERED\",\"statusDescription\":\"Package delivered successfully\",\"trackingList\":[{\"desc\":\"Delivered\",\"location\":\"New York, US\",\"status\":\"DELIVERED\",\"time\":\"2024-01-15T10:30:00Z\"},{\"desc\":\"Out for delivery\",\"location\":\"New York, US\",\"status\":\"IN_TRANSIT\",\"time\":\"2024-01-14T08:00:00Z\"}]},\"success\":true},\"schema\":{\"properties\":{\"data\":{\"properties\":{\"destCountry\":{\"description\":\"Destination country code\",\"type\":\"string\"},\"latestTrackingInfo\":{\"properties\":{\"desc\":{\"description\":\"Description of the latest tracking event\",\"type\":\"string\"},\"location\":{\"description\":\"Location of the latest tracking event\",\"type\":\"string\"},\"time\":{\"description\":\"Timestamp of the latest tracking event\",\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"mailNo\":{\"description\":\"The tracking number of the shipment\",\"type\":\"string\"},\"originCountry\":{\"description\":\"Origin country code\",\"type\":\"string\"},\"status\":{\"description\":\"Current status of the shipment\",\"type\":\"string\"},\"statusDescription\":{\"description\":\"Detailed description of the current status\",\"type\":\"string\"},\"trackingList\":{\"description\":\"Complete tracking history\",\"items\":{\"properties\":{\"desc\":{\"description\":\"Description of the tracking event\",\"type\":\"string\"},\"location\":{\"description\":\"Location of the tracking event\",\"type\":\"string\"},\"status\":{\"description\":\"Status at this tracking point\",\"type\":\"string\"},\"time\":{\"description\":\"Timestamp of the tracking event\",\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"errorCode\":{\"description\":\"Error code if applicable\",\"type\":\"string\"},\"errorMsg\":{\"description\":\"Error message if applicable\",\"type\":\"string\"},\"success\":{\"description\":\"Indicates if the request was successful\",\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Successful response with tracking details\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errorCode\":{\"example\":\"INVALID_PARAMETER\",\"type\":\"string\"},\"errorMsg\":{\"example\":\"Invalid tracking number format\",\"type\":\"string\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Bad request - Invalid parameters\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errorCode\":{\"example\":\"NOT_FOUND\",\"type\":\"string\"},\"errorMsg\":{\"example\":\"Tracking number not found in system\",\"type\":\"string\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Tracking number not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errorCode\":{\"example\":\"INTERNAL_ERROR\",\"type\":\"string\"},\"errorMsg\":{\"example\":\"An internal error occurred\",\"type\":\"string\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}",
